{
  "openapi": "3.0.3",
  "info": {
    "title": "Array oneOf Single Enum Items",
    "description": "Tests array schema where items use oneOf with single-item enum subschemas. Previously rendered as multi-select, now renders as add/remove list with polymorphic selection.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.example.com/v1"
    }
  ],
  "paths": {
    "/notifications/preferences": {
      "put": {
        "summary": "Update notification preferences",
        "operationId": "updateNotificationPreferences",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "channels": {
                    "type": "array",
                    "description": "List of notification channels to enable",
                    "uniqueItems": true,
                    "items": {
                      "oneOf": [
                        {
                          "title": "Email",
                          "type": "string",
                          "enum": [
                            "email"
                          ]
                        },
                        {
                          "title": "SMS",
                          "type": "string",
                          "enum": [
                            "sms"
                          ]
                        },
                        {
                          "title": "Push Notification",
                          "type": "string",
                          "enum": [
                            "push"
                          ]
                        },
                        {
                          "title": "Webhook",
                          "type": "string",
                          "enum": [
                            "webhook"
                          ]
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Preferences updated successfully"
          }
        }
      }
    }
  }
}